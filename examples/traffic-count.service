[Unit]
Description=Per-device LAN traffic accounting (eBPF)
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/traffic-count --config /etc/traffic-count/config.json
Restart=on-failure
RestartSec=5s

# Loading BPF programs and attaching them to interfaces needs these.
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_SYS_RESOURCE
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_SYS_RESOURCE
StateDirectory=traffic-count
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/traffic-count
ReadWritePaths=/var/lib/traffic-count
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=traffic-count

[Install]
WantedBy=multi-user.target
