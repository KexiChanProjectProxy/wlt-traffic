#!/bin/sh
set -e

case "$1" in
    configure)
        mkdir -p /var/lib/traffic-count
        # The BPF object is embedded in /usr/bin/traffic-count; nothing to compile.
        rm -f /usr/lib/traffic-count/traffic_count_bpfel.o
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            if systemctl is-enabled --quiet traffic-count 2>/dev/null; then
                systemctl restart traffic-count || true
            fi
        fi
        ;;
esac

exit 0
