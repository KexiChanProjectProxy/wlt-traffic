#!/usr/bin/make -f
# Builds a binary .deb for the architecture of the build machine.
# The BPF object is embedded in the Go binary (internal/ebpf/traffic_bpfel.o),
# so the package has no compiler or libbpf dependency.
#   debian/rules binary          -> ../traffic-count_<version>_<arch>.deb

CURDIR  := $(shell pwd)
PKGDIR  := $(CURDIR)/debian/tmp
VERSION ?= $(shell dpkg-parsechangelog -S Version 2>/dev/null || echo 2.0.0)
ARCH    ?= $(shell dpkg --print-architecture)

.PHONY: build binary clean

build:
	rm -rf $(PKGDIR)
	mkdir -p $(PKGDIR)/DEBIAN $(PKGDIR)/usr/bin $(PKGDIR)/etc/traffic-count $(PKGDIR)/lib/systemd/system
	CGO_ENABLED=1 go build -trimpath -ldflags="-s -w" -o $(PKGDIR)/usr/bin/traffic-count ./cmd/traffic-count
	install -m 644 examples/config.json $(PKGDIR)/etc/traffic-count/config.json
	install -m 644 examples/traffic-count.service $(PKGDIR)/lib/systemd/system/traffic-count.service
	install -m 755 debian/postinst debian/prerm $(PKGDIR)/DEBIAN/
	echo /etc/traffic-count/config.json > $(PKGDIR)/DEBIAN/conffiles
	printf '%s\n' \
	  "Package: traffic-count" \
	  "Version: $(VERSION)" \
	  "Architecture: $(ARCH)" \
	  "Maintainer: KexiChan Project <kexi@example.com>" \
	  "Depends: libc6" \
	  "Section: net" \
	  "Priority: optional" \
	  "Description: per-device LAN traffic accounting using eBPF" \
	  " traffic-count attaches eBPF programs to LAN interfaces and counts" \
	  " upload/download bytes per device MAC address, stored in SQLite and" \
	  " served over a loopback JSON API." > $(PKGDIR)/DEBIAN/control

binary: build
	chmod -R go-w $(PKGDIR)
	dpkg-deb --root-owner-group --build $(PKGDIR) ../traffic-count_$(VERSION)_$(ARCH).deb

clean:
	rm -rf $(PKGDIR)
